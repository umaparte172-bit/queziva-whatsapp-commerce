# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public HTTPS URL of this server (used for webhook URLs and links)
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata

# SQLite for local dev. Production: postgresql://user:pass@host:5432/queziva
DATABASE_URL=file:./dev.db

# ── Order rules ──────────────────────────────────────
ORDER_ID_PREFIX=QZ
REQUEST_ID_PREFIX=RQ
# true = catalogue prices already include GST (shown as "incl. GST", not added on top)
PRICES_INCLUDE_GST=true
# 300 = 3% (jewellery)
DEFAULT_GST_RATE_BPS=300
# Used in customer-facing messages
BRAND_NAME=Queziva

# ── Integrations: mock | live ────────────────────────
WHATSAPP_MODE=mock
RAZORPAY_MODE=mock
SHIPROCKET_MODE=mock

# ── WhatsApp Cloud API (required when WHATSAPP_MODE=live) ──
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_CATALOG_ID=
WHATSAPP_APP_SECRET=
# Any random string; entered in Meta App → Webhooks when subscribing
WHATSAPP_VERIFY_TOKEN=
# Exact name of the payment configuration in WhatsApp Manager
WHATSAPP_PAYMENT_CONFIGURATION=

# Approved templates for messages sent after the 24-hour window (see docs/whatsapp-templates.md)
WHATSAPP_TEMPLATE_LANGUAGE=en
TEMPLATE_ORDER_UPDATE=qz_order_update
TEMPLATE_ADDRESS_REQUEST=qz_address_request
TEMPLATE_ORDER_CANCELLED=qz_order_cancelled
TEMPLATE_PAYMENT_REQUEST=qz_payment_request
TEMPLATE_ORDER_CONFIRMED=qz_order_confirmed
TEMPLATE_ORDER_DISPATCHED=qz_order_dispatched
TEMPLATE_IN_TRANSIT=qz_in_transit
TEMPLATE_OUT_FOR_DELIVERY=qz_out_for_delivery
TEMPLATE_DELIVERY_ATTEMPT=qz_delivery_attempt
TEMPLATE_ORDER_DELIVERED=qz_order_delivered
TEMPLATE_FEEDBACK_REQUEST=qz_feedback_request

# Customer response timeouts in hours (0 = off)
APPROVAL_REMINDER_HOURS=12
APPROVAL_TIMEOUT_HOURS=48
ADDRESS_REMINDER_HOURS=12
ADDRESS_TIMEOUT_HOURS=72
PAYMENT_REMINDER_HOURS=12
PAYMENT_EXPIRY_HOURS=48

# ── Razorpay (required when RAZORPAY_MODE=live) ──────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket (required when SHIPROCKET_MODE=live) ──
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as in Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=110001
# Token Shiprocket sends in the x-api-key header of tracking webhooks
SHIPROCKET_WEBHOOK_TOKEN=
# Billing email for Shiprocket orders (WhatsApp does not give us the customer's email)
SHIPROCKET_FALLBACK_EMAIL=

# ── Shipping rules ───────────────────────────────────
# cheapest | fastest | recommended (Shiprocket's pick)
SHIPPING_COURIER_STRATEGY=cheapest
# Free shipping when the product total (after discount) reaches this. 0 = off
FREE_SHIPPING_ABOVE_RUPEES=0
# Fixed shipping charge for customers; leave empty to charge the courier rate
SHIPPING_FLAT_RATE_RUPEES=
PACKAGING_WEIGHT_GRAMS=50
SHIPPING_ROUND_TO_RUPEE=true

# ── Admin dashboard ──────────────────────────────────
# 32+ random characters, required in production (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
# First admin login, created by `npm run db:seed` if no admin exists yet
ADMIN_EMAIL=admin@queziva.local
ADMIN_PASSWORD=
ADMIN_NAME=Queziva Admin
