{
  "name": "queziva-whatsapp-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Native WhatsApp ordering, payment (Razorpay) and shipping (Shiprocket) workflow for Queziva",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && vite build --config admin/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "admin:create": "tsx scripts/createAdmin.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:typecheck": "tsc -p admin/tsconfig.json",
    "db:postgres:sync": "node scripts/sync-postgres-schema.mjs",
    "db:postgres:migration": "prisma migrate dev --schema prisma/postgres/schema.prisma --create-only",
    "db:deploy": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "build:prod": "node scripts/sync-postgres-schema.mjs && prisma generate --schema prisma/postgres/schema.prisma && tsc -p tsconfig.json && vite build --config admin/vite.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
